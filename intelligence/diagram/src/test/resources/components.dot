  rankdir=LR;
  n1 [label="alpha"];
  n2 [label="beta"];
  r1 [label="artifact.missing (3)", shape=box, style=dotted];
  r2 [label="artifact.not-analysed (2)", shape=box, style=dotted];
  n1 -> r1 [label="? depends_on; build-model=1; unresolved=1", style=dotted];
  n1 -> r2 [label="? depends_on; build-model=1; not-analysed=1", style=dotted];
  n1 -> n2 [label="depends_on:generator-input; build-model=1; exact=1", style=solid];
  n1 -> n2 [label="depends_on:jvm-library; content=1; exact=1", style=solid];
