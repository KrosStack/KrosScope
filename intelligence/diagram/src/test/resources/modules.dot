digraph diagram {
  graph [label="Modules: 12 of 12 nodes, 14 of 15 links", labelloc=t];
  rankdir=LR;
  n1 [label=":module0"];
  n2 [label=":module1"];
  n3 [label=":module2"];
  n4 [label=":module3"];
  n5 [label=":module4"];
  n6 [label=":module5"];
  n7 [label=":module6"];
  n8 [label=":module7"];
  n9 [label=":module8"];
  n10 [label=":module9"];
  subgraph cluster_g1 {
    label="alpha";
