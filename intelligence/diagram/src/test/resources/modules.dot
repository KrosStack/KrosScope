  r1 [label="artifact.missing (3)", shape=box, style=dotted];
  r2 [label="artifact.not-analysed (2)", shape=box, style=dotted];
  n1 -> n2 [label="depends_on [cycle]; build-model=1,convention=1; exact=1,heuristic=1", style=dashed];
  n1 -> n6 [label="depends_on:maven-coordinates; build-model=1; exact=1", style=solid];
  n2 -> n1 [label="depends_on [cycle]; build-model=1; exact=1", style=solid];
  n2 -> n3 [label="depends_on; build-model=1; probable=1", style=dashed];
  n2 -> n7 [label="depends_on:jvm-library; content=1; exact=1", style=solid];
  n3 -> n4 [label="depends_on; build-model=1; heuristic=1", style=dashed];
  n3 -> n8 [label="depends_on:native-library; build-model=1; probable=1", style=dashed];
  n4 -> r1 [label="? depends_on; build-model=1; unresolved=1", style=dotted];
  n4 -> n9 [label="depends_on:web-bundle; build-model=1; heuristic=1", style=dashed];
  n5 -> r2 [label="? depends_on; build-model=1; not-analysed=1", style=dotted];
  n5 -> n10 [label="depends_on:generator-input; build-model=1; exact=1", style=solid];
