CREATE TABLE TaskRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    priority INTEGER NOT NULL DEFAULT 1,
    due_at INTEGER,
    done INTEGER NOT NULL DEFAULT 0,
    sync_state TEXT NOT NULL DEFAULT 'PENDING',
    synced_at INTEGER,
    updated_at INTEGER NOT NULL
);

CREATE INDEX task_priority_idx ON TaskRow(priority);

selectAll:
SELECT * FROM TaskRow ORDER BY done, priority DESC, due_at IS NULL, due_at;

selectById:
SELECT * FROM TaskRow WHERE id = ?;

selectPending:
SELECT * FROM TaskRow WHERE sync_state = 'PENDING';

countOpenByPriority:
SELECT priority, COUNT(*) AS open_count FROM TaskRow WHERE done = 0 GROUP BY priority;

upsert:
INSERT OR REPLACE INTO TaskRow VALUES ?;

markSynced:
UPDATE TaskRow SET sync_state = 'SYNCED', synced_at = ? WHERE id = ?;

deleteById:
DELETE FROM TaskRow WHERE id = ?;

lastSyncedAt:
SELECT MAX(synced_at) AS last_synced FROM TaskRow;
